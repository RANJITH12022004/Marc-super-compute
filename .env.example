# .env.example — copy to .env and fill in real values (never commit secrets)
# Values below are placeholders, not real secrets.

# --- Model API ---
# API key for the LLM provider (placeholder format).
MODEL_API_KEY=LLM_...

# --- MARC core ---
# Planner backend: muse
MARC_PLANNER=muse
# sandbox = drafts only, never auto-send. live = confirm-gated real sends.
MARC_MODE=sandbox
# desk = normal replies. driving = helmet/car: short TTS, voice confirm, hop cap 6.
MARC_CONTEXT=desk
# driving hop cap is 6 vs desk 8 (MARC_PLAN_MAX_HOPS still 8; driving profile tightens at runtime).
MARC_MUSE_URL=http://127.0.0.1:8096
MARC_MUSE_BIND=127.0.0.1
MARC_MUSE_PORT=8096
# Bearer token required on every marc-api / marc-muse coordinator call
# (see docs/marc_prd.md §15). Blank here is only a placeholder — set a real one.
MARC_TOKEN=
# Laptop worker base URL when the Windows worker is up (blank = laptop offline).
MARC_LAPTOP_URL=
# Local mind/state directory.
MARC_MIND_DIR=./var/mind
# Daily credit spend cap (shared Spark + Wonder ceiling; see docs/marc_prd.md §10).
MARC_CREDIT_DAILY_CAP=8.00
# Model names for spark/wonder planners.
MARC_SPARK_MODEL=muse-spark-1.3
MARC_WONDER_MODEL=muse-wonder-1.0
# Planner hop limits.
MARC_PLAN_MAX_HOPS=8
MARC_PLAN_HARD_HOPS=14

# --- Confirm-gated live tools ---
# Live send is confirm-gated: tools listed here require explicit confirmation in live mode.
# In sandbox mode sends are simulated/blocked by default.
CONFIRM_TOOLS=mail_send,mail_compose,whatsapp_send,instagram_send,sms_send,calendar_create,dial,open_food_search

# --- Meta (WhatsApp / Instagram) ---
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_IG_PAGE_ID=
META_APP_SECRET=

# --- Google ---
# Path to Google OAuth token file (e.g. ./var/google-token.json).
GOOGLE_TOKEN_PATH=
