<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bee_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/setup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Setup"
            android:textColor="@color/bee_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="API key"
            android:textColor="@color/bee_ink"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/bee_surface"
            android:hint="paste key"
            android:inputType="textPassword"
            android:textColor="@color/bee_ink"
            android:textColorHint="@color/bee_honey" />

        <TextView
            android:id="@+id/masked_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/bee_surface"
            android:padding="12dp"
            android:text="No key saved"
            android:textColor="@color/bee_ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Models"
            android:textColor="@color/bee_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/model_spark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/bee_surface"
            android:padding="12dp"
            android:text="muse-spark-1.3"
            android:textColor="@color/bee_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/model_wonder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/bee_surface"
            android:padding="12dp"
            android:text="muse-wonder-1.0"
            android:textColor="@color/bee_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/model_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/bee_surface"
            android:padding="12dp"
            android:text="muse-voice-transcribe-1.0"
            android:textColor="@color/bee_ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="MARC_MODE"
            android:textColor="@color/bee_ink"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/marc_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/bee_surface"
            android:orientation="horizontal"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/mode_sandbox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="sandbox"
                android:textColor="@color/bee_ink" />

            <RadioButton
                android:id="@+id/mode_live"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="live"
                android:textColor="@color/bee_ink" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/bee_surface"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Driving mode"
                android:textColor="@color/bee_ink"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/driving_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/play_water"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/bee_honey"
            android:text="Play water"
            android:textColor="@color/bee_page" />

        <Button
            android:id="@+id/enable_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/bee_honey"
            android:text="Turn on bee accessibility"
            android:textColor="@color/bee_page" />
    </LinearLayout>
</ScrollView>
