<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bee_page"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/chat_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chat"
        android:textColor="@color/bee_ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- One bubble per wave -->
    <ListView
        android:id="@+id/chat_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@color/bee_page"
        android:divider="@color/bee_surface"
        android:dividerHeight="8dp" />

    <!-- Confirm row Yes / Cancel -->
    <LinearLayout
        android:id="@+id/confirm_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/bee_surface"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/confirm_yes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/bee_ok"
            android:text="Yes"
            android:textColor="@color/bee_page" />

        <Button
            android:id="@+id/confirm_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/bee_ink" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/bee_surface"
        android:orientation="horizontal">

        <Button
            android:id="@+id/nav_island"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Island"
            android:textColor="@color/bee_ink" />

        <Button
            android:id="@+id/nav_chat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chat"
            android:textColor="@color/bee_honey" />

        <Button
            android:id="@+id/nav_setup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Setup"
            android:textColor="@color/bee_ink" />
    </LinearLayout>
</LinearLayout>
