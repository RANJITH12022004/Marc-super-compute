<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bee_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/island_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/home_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Island"
                    android:textColor="@color/bee_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/live_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/bee_surface"
                    android:paddingLeft="16dp"
                    android:paddingTop="8dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="8dp"
                    android:text="Idle"
                    android:textColor="@color/bee_honey"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/island_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/bee_surface"
                    android:padding="12dp"
                    android:text="Live pill preview"
                    android:textColor="@color/bee_ink"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/model_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/chip_spark"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Spark"
                        android:textColor="@color/bee_ink" />

                    <Button
                        android:id="@+id/chip_wonder"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Wonder"
                        android:textColor="@color/bee_ink" />

                    <Button
                        android:id="@+id/chip_voice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Voice"
                        android:textColor="@color/bee_ink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/permission_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/bee_surface"
                    android:padding="12dp"
                    android:text="Permission status: checking…"
                    android:textColor="@color/bee_wait"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/listen_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Listen"
                    android:textColor="@color/bee_page"
                    android:backgroundTint="@color/bee_ok" />

                <Button
                    android:id="@+id/play_water"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/bee_honey"
                    android:text="Play water"
                    android:textColor="@color/bee_page" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/chat_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="@color/bee_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/empty_chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="No messages"
                android:textColor="@color/bee_ink" />

            <ListView
                android:id="@+id/chat_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:divider="@color/bee_surface"
                android:dividerHeight="8dp" />

            <LinearLayout
                android:id="@+id/confirm_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/bee_surface"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/confirm_yes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/bee_ok"
                    android:text="Yes"
                    android:textColor="@color/bee_page" />

                <Button
                    android:id="@+id/confirm_cancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textColor="@color/bee_ink" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/composer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/bee_surface"
                    android:hint="Ask bee"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/bee_ink"
                    android:textColorHint="@color/bee_honey" />

                <Button
                    android:id="@+id/send_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send"
                    android:textColor="@color/bee_page"
                    android:backgroundTint="@color/bee_honey" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/setup_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/setup_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Setup"
                    android:textColor="@color/bee_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="API key"
                    android:textColor="@color/bee_ink" />

                <EditText
                    android:id="@+id/api_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@color/bee_surface"
                    android:hint="paste key"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textColor="@color/bee_ink"
                    android:textColorHint="@color/bee_honey" />

                <TextView
                    android:id="@+id/masked_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@color/bee_surface"
                    android:padding="12dp"
                    android:text="No key saved"
                    android:textColor="@color/bee_ink" />

                <Button
                    android:id="@+id/save_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Save key"
                    android:textColor="@color/bee_page"
                    android:backgroundTint="@color/bee_honey" />

                <TextView
                    android:id="@+id/model_spark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/bee_surface"
                    android:padding="12dp"
                    android:text="muse-spark-1.3"
                    android:textColor="@color/bee_ink" />

                <TextView
                    android:id="@+id/model_wonder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@color/bee_surface"
                    android:padding="12dp"
                    android:text="muse-wonder-1.0"
                    android:textColor="@color/bee_ink" />

                <TextView
                    android:id="@+id/model_voice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@color/bee_surface"
                    android:padding="12dp"
                    android:text="muse-voice-transcribe-1.0"
                    android:textColor="@color/bee_ink" />

                <RadioGroup
                    android:id="@+id/marc_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/bee_surface"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <RadioButton
                        android:id="@+id/mode_sandbox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="sandbox"
                        android:textColor="@color/bee_ink" />

                    <RadioButton
                        android:id="@+id/mode_live"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="live"
                        android:textColor="@color/bee_ink" />
                </RadioGroup>

                <Switch
                    android:id="@+id/driving_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Driving mode"
                    android:textColor="@color/bee_ink" />

                <Button
                    android:id="@+id/setup_play_water"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/bee_honey"
                    android:text="Play water"
                    android:textColor="@color/bee_page" />

                <Button
                    android:id="@+id/enable_accessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/bee_honey"
                    android:text="Turn on bee accessibility"
                    android:textColor="@color/bee_page" />

                <Button
                    android:id="@+id/enable_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Turn on overlay"
                    android:textColor="@color/bee_ink" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bee_surface"
        android:orientation="horizontal">

        <Button
            android:id="@+id/nav_island"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Island"
            android:textColor="@color/bee_honey" />

        <Button
            android:id="@+id/nav_chat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chat"
            android:textColor="@color/bee_ink" />

        <Button
            android:id="@+id/nav_setup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Setup"
            android:textColor="@color/bee_ink" />
    </LinearLayout>
</LinearLayout>
